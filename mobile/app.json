{
  "expo": {
    "name": "Kunooz Mandoob",
    "slug": "Mandoob_App",
    "version": "1.0.2",
    
    "orientation": "portrait",
    "icon": "./assets/images/k_logo.png",
    "scheme": "mandoobapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF", 
        "foregroundImage": "./assets/images/k_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.khaled891.Mandoob_App",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/k_logo-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/k_logo.png",
          "color": "#3b82f6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "5bb05100-30db-49d5-afca-61dfe667f20d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5bb05100-30db-49d5-afca-61dfe667f20d"
    }
  }
}